# Python
__pycache__/
*.pyc

# PyInstaller 构建中间目录
bld/
bld_*/
bld[0-9]*/
bld_tmp/
chkb/
*.spec.bak

# 本地下载产物（含真实案件材料，不发布）
法院文书/

# 依赖 / 分块下载缓存
pipcache/
pymupdf.whl.parts/
.pybuild_cache/

# 测试产物
download_test*.pdf
chunk_*

# 本地记忆（不发布）
.workbuddy/

# 构建产物不入库（exe 通过 GitHub Releases 分发，仓库不再存二进制）
dist/

# 资料库上传中间物
_project_upload/

# 本机私有端点（源站地址等，绝不入库）
_endpoints.py

# ---- 敏感文件：凭据 / 证书 / 私钥 —— 任何情况下都不入库 ----
token.txt
*.token
.github_token
gh_token.txt
*.pfx
*.pvk
*.p12
*.pem
*.key
pfx_pass.txt
signing/
.env
.env.*
local_config.json
id_rsa
id_ed25519
.netrc
.git-credentials

# 例外：随程序分发的**公共** CA 证书（非私钥，公开信息，必须入库才能打包）
# 用 .crt 扩展名（证书的标准扩展名），避免与私钥类 *.pem 规则混淆。
!assets/ca/*.crt
